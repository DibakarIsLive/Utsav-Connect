# ------------------------------------------------------------------------------
# Utsav-Connect — environment variables
#
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# Next.js loads `.env.local` automatically; the test runner loads it through
# tests/setup/load-env.js. Never commit real credentials.
# ------------------------------------------------------------------------------

# MongoDB connection string for local development.
# Include the database name in the URI (Mongoose uses it as the default database).
MONGODB_URI=mongodb://127.0.0.1:27017/utsav_connect

# Separate database for the automated integration tests. Must NOT point at the
# development or production database: integration tests create and drop data.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/utsav_connect_test

# Public base URL of the running application (used for absolute links/metadata).
APP_BASE_URL=http://localhost:3000

# Logging verbosity for server-side logs: debug | info | warn | error
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Reserved for later roadmap stages — NOT read by the application yet.
# They are listed so the variable names are agreed early; leave them unset.
#
# AUTH_SECRET=                      # Stage 2 (authentication)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=  # Stage 3 (browser Maps JavaScript API key, restricted by referrer)
# GOOGLE_MAPS_SERVER_API_KEY=       # Stage 3 (server-side Geocoding/Places key, never exposed to the browser)
# ------------------------------------------------------------------------------
