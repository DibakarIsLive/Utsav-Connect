# Utsav-Connect — environment variables
# Copy to .env.local (git-ignored) and fill in real values. Never commit secrets.
#
# All variables below are validated at first server use (api/lib/env/env.js).
# Invalid values fail with the variable NAME only; values are never logged.

# --- MongoDB ---------------------------------------------------------------
# Application database. MongoDB Atlas (mongodb+srv://) is the project's cluster;
# a local server (mongodb://127.0.0.1:27017/utsav_connect) also works.
# Always include the database name in the path — without it MongoDB falls back to "test".
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/utsav_connect?retryWrites=true&w=majority&appName=<cluster-name>

# Integration-test database. Same cluster is fine, but the database NAME MUST END IN "_test";
# tests/helpers/database.js refuses to run against anything else.
MONGODB_URI_TEST=mongodb+srv://<db-user>:<db-password>@<cluster-host>/utsav_connect_test?retryWrites=true&w=majority&appName=<cluster-name>

# --- Application -------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# --- Authentication -----------------------------------------------------------
# At least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=

# open | closed — keep closed until email delivery is configured
REGISTRATION_MODE=closed

# Session lifetimes in days
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# --- Transactional email ------------------------------------------------------
# dev writes to .local/mail/ once mailer exists
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@example.com

# --- Reserved for later stages (NOT read by the application yet) --------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_SERVER_API_KEY=
