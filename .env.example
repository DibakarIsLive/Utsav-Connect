# Utsav-Connect — environment variables
# Copy to .env.local (git-ignored) and fill in real values. Never commit secrets.
#
# All variables below are validated at first server use (api/lib/env/env.js).
# Invalid values fail with the variable NAME only; values are never logged.

# --- MongoDB ---------------------------------------------------------------
# Application database. MongoDB Atlas (mongodb+srv://) is the project's cluster;
# a local server (mongodb://127.0.0.1:27017/utsav_connect) also works.
# Always include the database name in the path — without it MongoDB falls back to "test".
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/utsav_connect?retryWrites=true&w=majority&appName=<cluster-name>

# Integration-test database. Same cluster is fine, but the database NAME MUST END IN "_test";
# tests/helpers/database.js refuses to run against anything else.
MONGODB_URI_TEST=mongodb+srv://<db-user>:<db-password>@<cluster-host>/utsav_connect_test?retryWrites=true&w=majority&appName=<cluster-name>

# --- Application -------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# --- Authentication -----------------------------------------------------------
# At least 32 random characters. Generate with: openssl rand -base64 48
# Required in production. Set in .env.local (never commit this file).
AUTH_SECRET=

# open | closed — keep closed until email delivery is configured
REGISTRATION_MODE=closed

# Super Admin CLI password visibility (interactive bootstrap only).
# false (default): hide password characters while typing.
# true: show password characters while typing. Unset/invalid defaults to hidden.
# This affects ONLY scripts/create-super-admin.js; website login, registration,
# and password reset always hide passwords. Never stored in MongoDB.
SUPER_ADMIN_SHOW_PASSWORD=false

# --- Local Development Test Credential Registry ---
# Master switch: if false, ALL credential storage is disabled regardless of
# the three role-specific settings below. Only explicit "true" (case-insensitive)
# enables storage. Missing/empty/invalid defaults to false.
STORE_CREDENTIALS_FOR_ALL_USERS=false

# Role-specific settings (only evaluated when master switch is true).
# Each must be explicit "true" to enable storage for that role.
STORE_CREDENTIALS_FOR_ALL_SUPER_ADMINS=false
STORE_CREDENTIALS_FOR_ALL_ADMINS=false
STORE_CREDENTIALS_FOR_ALL_DEVOTEES=false

# These settings are server-side only. They must never be exposed through
# NEXT_PUBLIC_* variables, browser code, frontend bundles, or API responses.
# Plaintext passwords are stored in .local/test-users/ ONLY when:
#   1. STORE_CREDENTIALS_FOR_ALL_USERS=true, AND
#   2. The matching role-specific setting is true, AND
#   3. NODE_ENV=development (not production/staging/other deployed env).
# MongoDB remains the only source of truth for authentication.
#
# These settings are read from .env.local only when the Next.js dev server
# starts. Changing them requires restarting the running dev server; they do
# not take effect at runtime without a restart.

# Session lifetimes in days
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# --- Transactional email ------------------------------------------------------
# dev    writes .eml files to .local/mail/ and never sends real email
# resend sends through the Resend REST API (requires EMAIL_API_KEY)
EMAIL_PROVIDER=dev
# Must be a sender verified by the selected provider. Until it is, keep
# EMAIL_PROVIDER=dev and REGISTRATION_MODE=closed.
EMAIL_FROM=no-reply@example.com
# Required when EMAIL_PROVIDER=resend. Never commit the value.
EMAIL_API_KEY=

# --- Google Maps (optional) ---------------------------------------------------
# The current UI renders an honest static/illustrative map when no key is set.
# A browser-restricted key enables the interactive Google map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-side Places/Geocoding calls, when implemented. Restrict by API and IP.
GOOGLE_MAPS_SERVER_API_KEY=
