{
  "name": "utsav-connect",
  "version": "0.1.0",
  "private": true,
  "description": "Mahotsav outreach platform: geographic areas, invitation reporting, and coverage analytics built with Next.js, JavaScript, and MongoDB.",
  "type": "module",
  "engines": {
    "node": ">=20.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:js-only": "node scripts/check-javascript-only.js",
    "check:db": "node scripts/check-mongodb.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "check": "npm run check:js-only && npm run lint && npm run format:check && npm run test:unit"
  },
  "dependencies": {
    "mongoose": "^9.11.4",
    "next": "16.4.4",
    "playwright": "^1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "vitest": "^4.1.12"
  }
}
